{
  "name": "cashstack-api",
  "version": "0.1.0",
  "private": true,
  "description": "CashStack's backend: Sign in with Apple, sessions, and a read-only Basiq (CDR) proxy.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "migrate": "node src/migrate.ts",
