# Copy to .env for local runs: `node --env-file=.env src/index.ts`
# With nothing set, the server runs against a fake Basiq and an embedded
# database in .data/, which is enough to drive the whole app flow.

# NODE_ENV=development
# HOST=127.0.0.1
# PORT=8080
# PUBLIC_URL=http://127.0.0.1:8080

# Development only — sign in without Apple. Production refuses to start with it.
DEV_LOGIN=1

# Basiq sandbox: switch to live and paste a sandbox API key from dashboard.basiq.io.
# BASIQ_MODE=live
# BASIQ_API_KEY=
# BASIQ_WEBHOOK_SECRET=whsec_...

# Production also needs (set with `fly secrets set`):
# DATABASE_URL=postgres://...
# DATA_KEY=            # openssl rand -base64 32
# APPLE_TEAM_ID=URYQTTYR57
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=   # the .p8, with newlines as \n

# Turning old builds away and switching the app off (fly secrets set …):
# MIN_APP_BUILD=0      # builds below this CFBundleVersion must update
# APP_UPDATE_URL=      # itms-apps://apps.apple.com/app/id… once the listing exists
# MAINTENANCE_MESSAGE= # e.g. "We're upgrading CashStack. Back by 9pm."

# Optional: a Slack incoming webhook for app crashes and server errors.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/…
